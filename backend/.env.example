# Server
PORT=3000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/finhelper

# JWT
JWT_SECRET=your-very-strong-secret-key-here
JWT_REFRESH_SECRET=your-very-strong-refresh-secret-key-here

# CORS - virgülle ayrılmış izin verilen origin'ler
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081

# App URL (email linkleri için)
APP_URL=http://localhost:3000

# Email - Mailtrap (development): https://mailtrap.io > Email Testing > SMTP Settings
EMAIL_HOST=sandbox.smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=your-mailtrap-username
EMAIL_PASS=your-mailtrap-password
EMAIL_FROM=noreply@finhelper.com
